# Copy to config/.env.omagmes and keep the copied file untracked.
# Internal factory network only; rely on existing network access controls and never expose publicly.
# Writes require explicit OMAG target and DBA schema-permission confirmation.
OMAGMES_CONFIG_SQL_SERVER=10.28.255.98
OMAGMES_CONFIG_SQL_DATABASE=OMAG
OMAGMES_CONFIG_SQL_DRIVER=ODBC Driver 18 for SQL Server
OMAGMES_CONFIG_SQL_TRUSTED_CONNECTION=false
OMAGMES_CONFIG_SQL_USER=
OMAGMES_CONFIG_SQL_PASS=
OMAGMES_CONFIG_SQL_ENCRYPT=true
OMAGMES_CONFIG_SQL_TRUST_SERVER_CERTIFICATE=false
OMAGMES_CONFIG_TARGET_CONFIRMED=false
OMAGMES_CONFIG_WRITE_CONFIRMED=false
