# User-facing OmagMES application port (Vite development/preview server).
# Vite serves on the factory LAN; factory network controls govern who can reach it.
APP_PORT=3001

# FastAPI remains an internal loopback service on 127.0.0.1:8000; do not expose it to users.
# The internal app does not use per-user application authentication; do not publish it outside
# the factory network or bypass the site's network-level access controls.

# SQL source settings are intentionally not populated in this example.
# Copy only separately approved settings into the local .env file.

# Operational SQL writes use the OMAG_MES database service login and remain
# unavailable until the required schema and object-level database permissions exist.
